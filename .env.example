# =====================================================================
#  Fudo configuration: copy to .env and adjust
#     cp .env.example .env
#
#  Rules
#   - No quotes and no spaces around "=".  Good: PUBLIC_URL=https://fudo.example.com
#   - Save the file with Unix (LF) line endings if you edit it on Windows.
#   - Keep this file private: it contains the database password and APP_SECRET.
# =====================================================================

# ---- Database (TimescaleDB container) --------------------------------
POSTGRES_USER=fudo
# Letters and digits only: the password is embedded in a connection URL,
# so characters like @ : / # ? % would break it.
POSTGRES_PASSWORD=ChangeMe2026Fudo7pQx
POSTGRES_DB=fudo

# ---- Application secret ----------------------------------------------
# At least 32 characters. Encrypts 2FA secrets and stored passwords.
# Generate your own:   openssl rand -base64 48
# (PowerShell:  [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })) )
# Back it up with the database; changing it later makes stored 2FA secrets unreadable.
APP_SECRET=REPLACE-ME-6f1c0e9d4b7a2e58c3f9a1d7b6e4c2f0a8d5b3e1c7f9a2d4

# ---- Public address ---------------------------------------------------
# The URL people type in the browser. Used in invitation emails and push URLs.
# Must start with http:// or https://. Include the port if it is not 80/443.
#   Behind a reverse proxy with TLS:  PUBLIC_URL=https://fudo.example.com
#   Direct on port 8080:              PUBLIC_URL=http://fudo.example.com:8080
# Leave empty to use whatever address the browser used.
PUBLIC_URL=http://fudo.example.com:8080

# Port on the Docker host where the web UI is published.
WEB_PORT=8080

# ---- Sign-in ----------------------------------------------------------
# Hours until a session expires and users sign in again.
SESSION_TTL_HOURS=12
# auto  = Secure cookie when the browser uses HTTPS (recommended)
# true  = always Secure (only works over HTTPS)
# false = never Secure (plain HTTP only, e.g. a lab)
COOKIE_SECURE=auto

# ---- Monitoring ---------------------------------------------------------
# Checks the worker runs in parallel.
CHECK_CONCURRENCY=50

# SNMP traps: the UDP port devices send to on this host (the standard is 162).
# TRAP_PORT=162

# Docker container monitors on this host (see docker-compose.yml, worker service):
# group id of the "docker" group on the host:  getent group docker | cut -d: -f3
# DOCKER_GID=999

# ---- Languages ------------------------------------------------------------
# Folder (inside the api container) with extra or corrected language files, e.g. /locales-extra
# LOCALES_DIR=
# Folder with extra themes (see themes/README.md)
# THEMES_DIR=

# ---- Logging --------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Local development only (pnpm dev, not used by docker compose) ---------
# docker compose builds the connection from the POSTGRES_* values above.
DATABASE_URL=postgres://fudo:ChangeMe2026Fudo7pQx@localhost:5432/fudo
API_PORT=3000
NODE_ENV=development
